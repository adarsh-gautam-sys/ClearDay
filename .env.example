# Optional AI Configuration (leave all unset for deterministic guided-offline mode):
# Option 1: Vertex AI via Cloud Run Service Account IAM / ADC (zero API keys)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Option 2: Vertex AI Express Mode API Key (note: standard GCP API keys are rejected by aiplatform)
VERTEX_API_KEY=

# Option 3: Gemini Developer API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Distributed Store (Redis HTTP REST or Cloud Firestore for multi-instance Cloud Run scaling)
# Option A: Upstash / Redis HTTP REST API
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Option B: Google Cloud Firestore native REST store (auto-enabled on Cloud Run when project ID is set)
FIRESTORE_CACHE_ENABLED=true
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=clearday_cache
