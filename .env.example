# Optional: Enables live Gemini 2.5 Flash personalization & SSE Copilot.
# Leave unset to run ClearDay in deterministic guided-offline mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Distributed Store (recommended for multi-instance Cloud Run scaling)
# Option A: Upstash / Redis HTTP REST API
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Option B: Google Cloud Firestore native REST store (uses Cloud Run service account)
FIRESTORE_CACHE_ENABLED=false
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=clearday_cache
